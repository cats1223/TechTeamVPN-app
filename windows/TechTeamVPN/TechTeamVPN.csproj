<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Windows app: a WPF window with WebView2 showing Web/ (the phone apps' interface),
       and xray.exe started next to it. CI publishes it self-contained (see build.yml). -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <!-- WPF and Windows Forms both define Application, MessageBox and friends; usings are explicit. -->
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>TechTeamVPN</AssemblyName>
    <RootNamespace>TechTeamVPN</RootNamespace>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- CI passes the release tag: dotnet publish -p:AppVersion=1.3.0 -->
    <AppVersion Condition="'$(AppVersion)' == ''">1.0.0</AppVersion>
    <Version>$([System.Text.RegularExpressions.Regex]::Match($(AppVersion), '^[0-9.]+').Value)</Version>
    <InformationalVersion>$(AppVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TechTeamVPN.Core\TechTeamVPN.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Web\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
